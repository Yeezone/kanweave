# 复制为 .env 或直接在 shell 里 export（本项目不自动加载 .env）

# ---- 独立站点 ----
# KW_PORT=4280
# KW_HOST=0.0.0.0
# KW_DATA_DIR=./.data
# KW_OPERATOR_NAME=本机用户

# ---- 公网部署（HTTPS）----
# 公开访问地址；以 https:// 开头时会自动给会话 Cookie 加 Secure
# KW_PUBLIC_URL=https://pm.example.com

# ---- 云端共享模式（DSH 插件指向云端那一个项目空间）----
# 设置后，插件进程不再本地存数据，而是把 /kanweave/* 反向代理到云端部署，
# 于是插件里的账号/看板与团队成员浏览器里完全一致。也可写成
# <DSH_HOME>/kanweave/cloud.json 里的 {"url": "https://pm.example.com"}。
# KW_CLOUD_URL=https://pm.example.com

# ---- 上传上限（字节，默认 1 GiB）----
# KW_MAX_ATTACHMENT_BYTES=1073741824

# ---- 会话 Cookie ----
# 不设置时：KW_PUBLIC_URL 是 https:// 就自动开启 Secure
# 纯 HTTP 的局域网演示环境必须显式关闭，否则浏览器不会回传 Cookie
# KW_COOKIE_SECURE=0

# ---- 账号注册 ----
# 默认开放自助注册（注册后无任何项目权限，仍需项目管理员邀请）
# 对外网暴露时建议关闭，只允许钉钉登录或邀请链接注册
# KW_ALLOW_REGISTRATION=0

# ---- DSH 插件形态的局域网访问 ----
# 插件默认只接受本机请求；要让同事直接访问 DSH 的 http://<你的IP>:55820 看板
# 需要打开下面这个开关（访问者仍需登录为项目成员，不能使用本机操作员身份）
# KW_ALLOW_LAN=1

# ---- 钉钉登录（企业内部应用）----
# 也可以不设环境变量，改在数据目录写 dingtalk.json（插件/桌面端推荐）：
#   node scripts/set-dingtalk.mjs --app-key ... --app-secret ... --corp-id ... --redirect-uri ...
# KW_DINGTALK_CLIENT_ID=dingxxxxxxxxxxxxxxxx
# KW_DINGTALK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KW_DINGTALK_CORP_ID=dingxxxxxxxxxxxxxxxx
# KW_DINGTALK_REDIRECT_URI=http://localhost:4280/kanweave/api/auth/dingtalk/callback
# 本地联调可临时启用演示登录（生产禁用）
# KW_DINGTALK_MOCK=1
